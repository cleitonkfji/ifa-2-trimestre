  <script>
    // Inicializar ícones
    lucide.createIcons();

    const apiKey = "";

    // Estado da Aplicação
    let currentFontSizePercent = 100;
    let isMagnifierActive = false;
    const synth = window.speechSynthesis;
    let selectedVoice = null;

    // --- MELHORIA DA IA DE VOZ ---
    function loadBestVoice() {
      if (!synth) return;
      const voices = synth.getVoices();
      
      // Procura por vozes em Português de alta qualidade
      selectedVoice = voices.find(v => v.lang.includes('pt') && (v.name.includes('Natural') || v.name.includes('Google') || v.name.includes('Luciana') || v.name.includes('Helena'))) 
                   || voices.find(v => v.lang.includes('pt-BR') || v.lang.includes('pt')) 
                   || voices[0];
    }

    if (synth) {
      loadBestVoice();
      if (speechSynthesis.onvoiceschanged !== undefined) {
        speechSynthesis.onvoiceschanged = loadBestVoice;
      }
    }

    function speakText(text) {
      if (!synth) return;

      synth.cancel();

      const utterance = new SpeechSynthesisUtterance(text);
      if (selectedVoice) utterance.voice = selectedVoice;
      
      utterance.lang = 'pt-BR';
      utterance.rate = 0.95;
      utterance.pitch = 1.0;

      synth.speak(utterance);
    }

    function stopSpeech() {
      if (synth) synth.cancel();
    }

    function speakPageOverview() {
      speakText("Você está no portal Visão Mais. O site oferece ferramentas de ampliação por lupa, dispositivos vestíveis como coletes e cintos assistivos, leitor por voz de alta definição, assistente de IA e telefones úteis de apoio.");
    }

    function startVoiceAssistance() {
      speakText("Assistente de áudio ativado. Pressione a tecla Tab para navegar pelos botões ou use o atalho Alt mais 1 para ler a página.");
    }

    // Leitura ao selecionar
    document.addEventListener('mouseup', () => {
      const selectedText = window.getSelection().toString().trim();
      if (selectedText.length > 2) {
        speakText(selectedText);
      }
    });

    // --- FONTE ---
    function changeFontSize(delta) {
      currentFontSizePercent = Math.max(80, Math.min(160, currentFontSizePercent + delta));
      document.documentElement.style.fontSize = `${currentFontSizePercent}%`;
      document.getElementById('font-size-label').innerText = `${currentFontSizePercent}%`;
      speakText(`Tamanho da fonte ajustado para ${currentFontSizePercent} por cento`);
    }

    // --- CONTRASTE ---
    function setTheme(theme) {
      const body = document.getElementById('app-body');
      body.classList.remove('high-contrast-yellow', 'high-contrast-black');

      if (theme === 'yellow') {
        body.classList.add('high-contrast-yellow');
        speakText("Modo Alto Contraste Amarelo e Preto ativado.");
      } else if (theme === 'black') {
        body.classList.add('high-contrast-black');
        speakText("Modo Alto Contraste Branco e Preto ativado.");
      } else {
        speakText("Tema Padrão ativado.");
      }
    }

    // --- LUPA APRIMORADA ---
    function toggleMagnifier() {
      isMagnifierActive = !isMagnifierActive;
      const lens = document.getElementById('magnifier-lens');
      const btnText = document.getElementById('btn-magnifier-text');

      if (isMagnifierActive) {
        lens.classList.remove('hidden');
        btnText.innerText = "Desativar Lupa Flutuante";
        speakText("Lupa de Alta Definição ativada. Mova o cursor do mouse sobre os elementos.");
        document.addEventListener('mousemove', moveMagnifier);
      } else {
        lens.classList.add('hidden');
        btnText.innerText = "Ativar Lupa Flutuante";
        speakText("Lupa desativada.");
        document.removeEventListener('mousemove', moveMagnifier);
      }
    }

    function moveMagnifier(e) {
      if (!isMagnifierActive) return;
      const lens = document.getElementById('magnifier-lens');
      const content = document.getElementById('magnifier-content');

      lens.style.left = `${e.clientX}px`;
      lens.style.top = `${e.clientY}px`;

      const elem = document.elementFromPoint(e.clientX, e.clientY);
      if (elem && elem.innerText && !lens.contains(elem)) {
        const textSample = elem.innerText.trim().substring(0, 60);
        if (textSample) {
          content.innerText = textSample;
        }
      }
    }

    // --- LEITOR IA (GEMINI) ---
    async function readAIText() {
      const text = document.getElementById('ai-text-input').value.trim();
      if (!text) {
        speakText("Por favor, digite ou cole um texto no campo antes de ouvir.");
        return;
      }
      speakText("Lendo texto: " + text);
    }

    async function summarizeAIText() {
      const text = document.getElementById('ai-text-input').value.trim();
      if (!text) {
        speakText("Por favor, cole um texto no campo para resumir com IA.");
        return;
      }

      speakText("Processando o resumo com Inteligência Artificial. Por favor aguarde.");

      const outputBox = document.getElementById('ai-output-box');
      const outputText = document.getElementById('ai-output-text');
      outputBox.classList.remove('hidden');
      outputText.innerText = "Gerando resumo simplificado...";

      const prompt = `Resuma o texto a seguir em português claro e objetivo para leitura de áudio para deficientes visuais: \n\n${text}`;
      
      try {
        const responseText = await fetchGeminiWithBackoff(prompt);
        outputText.innerText = responseText;
        speakText("Resumo concluído: " + responseText);
      } catch (err) {
        const fallbackSummary = text.substring(0, 150) + "...";
        outputText.innerText = fallbackSummary;
        speakText("Resumo rápido gerado: " + fallbackSummary);
      }
    }

    async function fetchGeminiWithBackoff(prompt) {
      const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
      const payload = { contents: [{ parts: [{ text: prompt }] }] };

      let delay = 1000;
      for (let attempt = 0; attempt < 5; attempt++) {
        try {
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            const data = await res.json();
            return data.candidates?.[0]?.content?.parts?.[0]?.text || "Resumo indisponível.";
          }
        } catch (e) {}
        await new Promise(r => setTimeout(r, delay));
        delay *= 2;
      }
      throw new Error("Falha de conexão com a API Gemini.");
    }

    // --- MODAL & ATALHOS ---
    function showShortcutsModal() {
      document.getElementById('shortcuts-modal').showModal();
      speakText("Modal de atalhos aberto.");
    }

    function closeShortcutsModal() {
      document.getElementById('shortcuts-modal').close();
      speakText("Modal fechado.");
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') stopSpeech();

      if (e.altKey) {
        if (e.key === '1') { e.preventDefault(); speakPageOverview(); }
        else if (e.key === '2') { e.preventDefault(); toggleMagnifier(); }
        else if (e.key === '3') { e.preventDefault(); document.getElementById('ai-text-input').focus(); speakText("Campo de texto IA focalizado."); }
        else if (e.key.toLowerCase() === 'h' || e.key.toLowerCase() === 'k') { e.preventDefault(); showShortcutsModal(); }
      }
    });
  </script>
